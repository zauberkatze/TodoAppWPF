<Window x:Class="TodoAppWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        TextElement.Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Title="Meine To-Do Listen"
        Height="800"
        Width="700"
        MinHeight="700"
        MinWidth="620">

    <Window.Resources>
        <Style x:Key="TodoListBoxItemStyle"
               TargetType="ListBoxItem">
            <EventSetter Event="PreviewMouseLeftButtonUp"
                         Handler="ListBoxItem_PreviewMouseLeftButtonUp"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titel -->
        <TextBlock Grid.Row="0"
               Text="Meine To-Do Listen"
               FontSize="24"
               FontWeight="SemiBold"
               Margin="0,0,0,24"/>

        <!-- Neue Liste erstellen -->
        <Grid Grid.Row="1"
              Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="ListenNameBox"
                     Grid.Column="0"
                     Style="{StaticResource AppTextBoxStyle}"
                     Margin="0,0,10,0"
                     ToolTip="Neue Liste..."/>

            <Button Grid.Column="1"
                    Style="{StaticResource AppButtonStyle}"
                    Click="NeueListeButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="+" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Neue Liste"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Listen Auswahl -->
        <Grid Grid.Row="2"
              Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="ListenAuswahl"
                      Grid.Column="0"
                      DisplayMemberPath="Name"
                      SelectionChanged="ListenAuswahl_SelectionChanged"/>

            <Button Grid.Column="1"
                    Margin="10,0,0,0"
                    Style="{StaticResource AppButtonStyle}"
                    Click="ListeLöschenButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🗑" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Liste löschen"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Eingabe -->
        <Grid Grid.Row="3"
              Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="EingabeBox"
                     Grid.Column="0"
                     Style="{StaticResource AppTextBoxStyle}"
                     Margin="0,0,10,0"
                     ToolTip="Neues Todo..."/>

            <Button x:Name="HinzufügenButton"
                    Grid.Column="1"
                    Style="{StaticResource AppButtonStyle}"
                    Click="HinzufügenButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="+" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Hinzufügen"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Todo Liste -->
        <ListBox x:Name="TodoListe"
             Grid.Row="4"
             ItemContainerStyle="{StaticResource TodoListBoxItemStyle}"
             ItemTemplate="{StaticResource TodoItemTemplate}"
             Background="Transparent"
             BorderThickness="0"/>

        <!-- Buttons unten -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">

            <Button Style="{StaticResource AppButtonStyle}"
                    Margin="0,0,10,0"
                    Click="SpeichernButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💾" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Speichern"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource AppButtonStyle}"
                    Click="LöschenButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🗑" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Löschen"/>
                </StackPanel>
            </Button>

        </StackPanel>
    </Grid>
</Window>