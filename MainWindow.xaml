<Window x:Class="TodoAppWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        Title="Meine To-Do Listen"
        Height="800"
        Width="700"
        MinHeight="700"
        MinWidth="620">

    <Window.Resources>
        <Style x:Key="TodoListBoxItemStyle" TargetType="ListBoxItem">
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="ListBoxItem_PreviewMouseLeftButtonUp"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titel -->
        <TextBlock Grid.Row="0"
                   Text="Meine To-Do Listen"
                   Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                   Margin="0,0,0,20"/>

        <!-- Neue Liste erstellen -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="ListenNameBox"
                     Grid.Column="0"
                     materialDesign:HintAssist.Hint="Neue Liste..."
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,10,0"/>

            <Button Grid.Column="1"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="NeueListeButton_Click">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Neue Liste"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Listen Auswahl -->
        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="ListenAuswahl"
                      Grid.Column="0"
                      materialDesign:HintAssist.Hint="Liste auswählen..."
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      DisplayMemberPath="Name"
                      SelectionChanged="ListenAuswahl_SelectionChanged"/>

            <Button Grid.Column="1"
                    Margin="10,0,0,0"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Foreground="White"
                    materialDesign:ButtonAssist.CornerRadius="4"
                    Background="{DynamicResource MaterialDesignValidationErrorBrush}"
                    BorderBrush="{DynamicResource MaterialDesignValidationErrorBrush}"
                    Click="ListeLöschenButton_Click">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Delete" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Liste löschen"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Eingabe -->
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="EingabeBox"
                     Grid.Column="0"
                     materialDesign:HintAssist.Hint="Neues Todo..."
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,10,0"/>

            <Button x:Name="HinzufügenButton"
                    Grid.Column="1"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="HinzufügenButton_Click">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="PlusCircle" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Hinzufügen"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Todo Liste -->
        <ListBox x:Name="TodoListe"
                 Grid.Row="4"
                 Style="{StaticResource MaterialDesignListBox}"
                 ItemContainerStyle="{StaticResource TodoListBoxItemStyle}"
                 ItemTemplate="{StaticResource TodoItemTemplate}"/>

        <!-- Buttons unten -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">

            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Margin="0,0,10,0"
                    Click="SpeichernButton_Click">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Speichern"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Foreground="White"
                    materialDesign:ButtonAssist.CornerRadius="4"
                    Background="{DynamicResource MaterialDesignValidationErrorBrush}"
                    BorderBrush="{DynamicResource MaterialDesignValidationErrorBrush}"
                    Click="LöschenButton_Click">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Delete" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Löschen"/>
                </StackPanel>
            </Button>

        </StackPanel>
    </Grid>
</Window>