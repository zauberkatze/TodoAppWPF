<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Basis Input Style für TextBox, ComboBox, ListBox -->
    <Style x:Key="BaseInputControlStyle" TargetType="Control">
        <Setter Property="Background" Value="#313244"/>
        <Setter Property="Foreground" Value="#CDD6F4"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="InputTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource BaseInputControlStyle}">
        <Setter Property="CaretBrush" Value="#CDD6F4"/>
    </Style>

    <Style x:Key="InputComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource BaseInputControlStyle}">
        <Setter Property="Foreground" Value="Black"/>
    </Style>

    <Style x:Key="TodoListBoxStyle" TargetType="ListBox" BasedOn="{StaticResource BaseInputControlStyle}"/>

</ResourceDictionary>
