<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

        <Style x:Key="AppButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinWidth" Value="120"/>
    </Style>

        <Style x:Key="AppTextBoxStyle" TargetType="TextBox">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="44"/>
    </Style>

        <Style x:Key="AppCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="0,6"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Background" Value="#FFF5F5F5"/>
    </Style>

    <DataTemplate x:Key="TodoItemTemplate">
        <Border Style="{StaticResource AppCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          IsChecked="{Binding Erledigt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,0,12,0"
                          VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding Titel}"
                           VerticalAlignment="Center"
                           FontSize="15">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Erledigt}"
                                        Value="True">
                                    <Setter Property="TextDecorations"
                                            Value="Strikethrough"/>
                                    <Setter Property="Opacity"
                                            Value="0.5"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>